# ── Base de datos (libSQL / Turso) ──────────────────────────────────────────
# Local (por defecto, archivo SQLite en ./db/dulces.db) — no hace falta nada.
# Producción (Vercel): crea tu base gratis en https://turso.tech y pon:
# TURSO_DATABASE_URL=libsql://tu-base-tu-usuario.turso.io
# TURSO_AUTH_TOKEN=eyJ...   (turso db tokens create tu-base)

# ── Admin ───────────────────────────────────────────────────────────────────
# Obligatorios en producción: sin ellos nadie entra al panel /admin
ADMIN_USER=tu-usuario
ADMIN_PASSWORD=tu-clave-segura
# Secreto para firmar la cookie de sesión (genera uno: openssl rand -hex 32)
AUTH_SECRET=cambia-esto-por-un-secreto-largo

# ── Fotos del admin (Vercel Blob) ───────────────────────────────────────────
# En Vercel se inyecta solo al conectar un Blob store (Storage → Blob).
# En local déjalo vacío: las fotos se guardan en public/uploads.
# BLOB_READ_WRITE_TOKEN=

# ── Tienda ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
NEXT_PUBLIC_WHATSAPP_NUMBER=584141234567
# Tasa Euro BCV de respaldo si la BD aún no tiene tasa guardada (opcional)
BCV_RATE_FALLBACK=989.72
